.nh
.TH "gapictl" "1" "Jan 1970" "gapictl 0.1.0-proto2l" "General Commands Manual"

.SH NAME
gapictl-crypto-encrypt - Encrypt data from stdin to stdout (AGE)


.SH SYNOPSIS
\fBgapictl crypto encrypt --recipient  [flags]\fP


.SH DESCRIPTION
Encrypt data from stdin to stdout (AGE)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for encrypt

.PP
\fB-r\fP, \fB--recipient\fP=[]
	Recipient public key(s)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for gapictl


.SH SEE ALSO
\fBgapictl-crypto(1)\fP
