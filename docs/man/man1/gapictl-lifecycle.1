.nh
.TH "gapictl" "1" "Jan 1970" "gapictl 0.1.0-proto2l" "General Commands Manual"

.SH NAME
gapictl-lifecycle - Control agent lifecycle


.SH SYNOPSIS
\fBgapictl lifecycle [flags]\fP


.SH DESCRIPTION
Control agent lifecycle


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for lifecycle


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for gapictl


.SH SEE ALSO
\fBgapictl(1)\fP, \fBgapictl-lifecycle-reload(1)\fP, \fBgapictl-lifecycle-restart(1)\fP, \fBgapictl-lifecycle-start(1)\fP, \fBgapictl-lifecycle-status(1)\fP, \fBgapictl-lifecycle-stop(1)\fP
