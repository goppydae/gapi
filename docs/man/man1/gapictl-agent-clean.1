.nh
.TH "gapictl" "1" "Jan 1970" "gapictl 0.1.0-proto2m" "General Commands Manual"

.SH NAME
gapictl-agent-clean - Clean build artifacts


.SH SYNOPSIS
\fBgapictl agent clean [flags]\fP


.SH DESCRIPTION
Remove all built binaries and checksums from agents/build/


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for clean


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for gapictl


.SH SEE ALSO
\fBgapictl-agent(1)\fP
