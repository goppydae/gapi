.nh
.TH "gapid" "1" "Jan 1970" "gapid 0.1.0-proto2l" "General Commands Manual"

.SH NAME
gapid - Supervision kernel daemon


.SH SYNOPSIS
\fBgapid [flags]\fP


.SH DESCRIPTION
Supervision kernel daemon


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for gapid

.PP
\fB--id\fP=""
	Unique node identifier (default: hostname)

.PP
\fB--log-file\fP=""
	Additional rotated file sink

.PP
\fB--log-format\fP=""
	Log format: json or console

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--log-loki-url\fP=""
	Forward logs to a Loki endpoint

.PP
\fB--metrics-addr\fP=""
	Prometheus listen address (empty: disabled)

.PP
\fB--tls-ca\fP=""
	CA certificate for peer verification

.PP
\fB--tls-cert\fP=""
	This node's certificate

.PP
\fB--tls-key\fP=""
	This node's private key

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for gapid


.SH SEE ALSO
\fBgapid-start(1)\fP, \fBgapid-version(1)\fP
