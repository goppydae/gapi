.nh
.TH "gapictl" "1" "Jan 1970" "gapictl 0.1.0-proto2l" "General Commands Manual"

.SH NAME
gapictl-crypto-sign - Sign a file and produce a detached .sig


.SH SYNOPSIS
\fBgapictl crypto sign  --key  [flags]\fP


.SH DESCRIPTION
Sign a file and produce a detached .sig


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for sign

.PP
\fB--key\fP=""
	Path to private key (PEM)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--control-addr\fP=""
	Address of the target daemon's control plane (empty: from config)

.PP
\fB--log-level\fP=""
	Log level: debug, info, warn, error

.PP
\fB--tls-ca\fP=""
	CA certificate used to verify the daemon

.PP
\fB--tls-insecure\fP[=false]
	Skip verification (INSECURE)

.PP
\fB-v\fP, \fB--version\fP[=false]
	version for gapictl


.SH SEE ALSO
\fBgapictl-crypto(1)\fP
