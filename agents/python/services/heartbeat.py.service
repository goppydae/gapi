import threading
import time
import sys

ID = "heartbeat"
NAME = "Heartbeat Monitor"
VERSION = "1.0.0"
TYPE = "service"
DESCRIPTION = "Periodically logs a heartbeat signal for monitoring."
ENABLED = True

# Internal control flag and thread
_running = False
_thread = None

def _heartbeat_loop():
    while _running:
        print(f"[heartbeat] heartbeat at {time.strftime('%Y-%m-%d %H:%M:%S')}", file=sys.stderr)
        time.sleep(5)

def initialize():
    print("[heartbeat] initialize called", file=sys.stderr)

def start():
    global _running, _thread
    if _running:
        print("[heartbeat] already running", file=sys.stderr)
        return
    print("[heartbeat] start called", file=sys.stderr)
    _running = True
    _thread = threading.Thread(target=_heartbeat_loop, daemon=False)
    _thread.start()

def stop():
    global _running, _thread
    if not _running:
        print("[heartbeat] already stopped", file=sys.stderr)
        return
    print("[heartbeat] stop called", file=sys.stderr)
    _running = False
    if _thread:
        _thread.join(timeout=6)
        _thread = None
    print("[heartbeat] stopped")

def restart():
    print("[heartbeat] restart called", file=sys.stderr)
    stop()
    start()
