# Makefile for python interface for package adk.
# File is generated by gopy. Do not edit.
# gopy build -output=adk/python/gapi/native -vm=python3 github.com/goppydae/gapi/adk/go

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=/home/sysop/go/src/github.com/goppydae/gapi/.venv/bin/python3
LIBEXT=.so

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-I/nix/store/3lll9y925zz9393sa59h653xik66srjb-python3-3.13.9/include/python3.13"
LDFLAGS = "-L/nix/store/3lll9y925zz9393sa59h653xik66srjb-python3-3.13.9/lib" "-lpython3.13" -ldl -lm

all: gen build

gen:
	gopy gen -no-make -vm=python3 github.com/goppydae/gapi/adk/go

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm adk.c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w adk.go
	# generate adk_go$(LIBEXT) from adk.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o adk_go$(LIBEXT) adk.go
	# use pybindgen to build the adk.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _adk$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated adk.py python wrapper imports this c-code package
	
	$(GCC) adk.c  adk_go$(LIBEXT) -o _adk$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w
	


