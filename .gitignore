# IDE files (Goland/JetBrains IDE)
.idea/
*.iml
*.ipr
*.iws

# Go binaries and build output
bin/
*.exe
*.dll
*.so
*.dylib
*.test

# Go environment files
vendor/
Godeps/
_go-build/

# Protobuf generated files
internal/proto/*.pb.go
internal/proto/*.pb.py
internal/proto/*_pb2.py
internal/proto/*_pb2_grpc.py

# Python environment and build fbin/
*.pyc
__pycache__/
.bin/
*.sig
*.key
*.pub
gapi.db
gapi.sock
test/tmp/
.vscode/
.idea/
COMMIT_MESSAGE.md
venv/
dist/
*.egg-info/

# Temporary files and directories
tmp/
*.log

# Database files
*.db
*.sqlite

# Air live reload temporary files
.air/

# Generated documentation
docs/_build/
docs/build/
docs/generated/

# Mage build artifacts
mage_output/

# Nix build outputs
result/
flake.lock

# Config backups and local overrides
config/*.local.*
config/*.backup.*

# OS-specific files
.DS_Store
Thumbs.db

# Editor backup files
*~

# VSCode editor files (if needed later)
.vscode/

# Test outputs and coverage reports
cover.out
coverage.txt
coverage.xml
test-results.xml

# Generated artifacts by buf/protobuf tools
buf.lock
buf.gen.yaml.lock
.bufbuild/

# Ignore local environment configuration files
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Ephemeral build data
build/meta/*
vendor/
