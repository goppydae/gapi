tmp/
test/tmp/
*.log
*.pid
*.sock
gapi.db
gapi.sock

# --- Databases (common local state) ---
*.db
*.sqlite

# --- Generated Documentation ---
docs/_build/
docs/build/
docs/generated/
site/
man/

# --- Mage Build Artifacts ---
mage_output/

# --- Air Live Reload ---
.air/

# --- TLS / Private Key Material ---
# gapi ships no key material and never should. Test and dev certificates
# are generated at runtime into a temp directory; a release build reads
# /etc/gapi. Six 24-hour self-signed keys were nonetheless committed over
# the project's life, every one of them swept in alongside unrelated work
# by a test script that wrote into a tracked path. These patterns make the
# next one require an explicit 'git add -f' to land.
config/certs/
*.key
*.pem
*.crt
*.cer
*.der
*.csr
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ecdsa
id_ed25519

# --- Local Environment / Backups ---
config/*.local.*
config/*.backup.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
COMMIT_MESSAGE.md

# --- Coverage / Test Reports ---
cover.out
coverage.txt
coverage.xml
test-results.xml

# --- Scenario Build Contexts (Silo) ---
scenarios/goblin_cluster/build_context/
